+pub fn read_frame_into(data: &[u8], start: usize, out: &mut Vec<u8>) -> Option<FrameMeta> {
+    out.clear();
     let mut cursor = Cursor { data, pos: start };
     let bits = cursor.bits(LENGTH_BITS)? as usize;
