+    #[test]
+    fn read_frame_into_matches_read_frame_and_reuses_capacity() {
+        let mut noise = Noise(0x517c_c1b7_2722_0a95);
+        let (data, _) = noise_stream(&mut noise, 4, 0);
+        let mut buf = Vec::with_capacity(PACKET_BYTES);
+        let ptr = buf.as_ptr();
+        let cap = buf.capacity();
+        let mut at = packet(&data, 0).map(|p| HEADER_BITS + p.first_frame_bit as usize);
+        let mut count = 0;
+        while let Some(bit) = at {
+            let expected = read_frame(&data, bit);
+            let meta = read_frame_into(&data, bit, &mut buf);
+            match (expected, meta) {
+                (Some(f), Some(m)) => {
+                    assert_eq!((m.bits, m.start, m.next), (f.bits, f.start, f.next));
+                    assert_eq!(buf, f.data);
+                    assert_eq!((buf.as_ptr(), buf.capacity()), (ptr, cap));
+                    at = m.next;
+                    count += 1;
+                }
+                (None, None) => {
+                    assert!(buf.is_empty());
+                    break;
+                }
+                _ => panic!("read_frame_into diverged from read_frame at bit {bit}"),
+            }
+        }
+        assert!(count > 4);
+        // A failing read leaves `buf` empty without discarding capacity.
+        assert!(read_frame_into(&data, data.len() * 8, &mut buf).is_none());
+        assert!(buf.is_empty());
+        assert_eq!((buf.as_ptr(), buf.capacity()), (ptr, cap));
+    }
