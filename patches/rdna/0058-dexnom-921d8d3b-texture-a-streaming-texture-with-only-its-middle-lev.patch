From b0df37f758ae0a449773f94af0522c4ae28b09e4 Mon Sep 17 00:00:00 2001
From: DexNom <29156494+DexNom@users.noreply.github.com>
Date: Fri, 27 Nov 2026 11:35:33 -0500
Subject: [PATCH 58/60] texture: a streaming texture with only its middle
 levels mapped is not taken for absent

With neither its first nor its last page committed a texture counted as
having nothing mapped, so one streaming in with only interior levels
resident was never staged and stayed black. The shortcut now holds for
a texture of a page or two; a longer one is asked of the host run by run.
Committed guard and no-access pages are not counted as there.

(cherry picked from DexNom/VIctory 921d8d3b, the sparse texture part)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G6tkVHCftUUQbGm5NirGaG
---
 crates/victory-gpu/src/texture.rs | 36 +++++++++++++++++++++++++++----
 1 file changed, 32 insertions(+), 4 deletions(-)

diff --git a/crates/victory-gpu/src/texture.rs b/crates/victory-gpu/src/texture.rs
index c725f3bd..e380fa9c 100644
--- a/crates/victory-gpu/src/texture.rs
+++ b/crates/victory-gpu/src/texture.rs
@@ -1782,7 +1782,9 @@ fn committed_by_query(at: *const u8, len: usize) -> bool {
 /// answer is none without a look at the pages between (two queries for the
 /// slots whose texture is away, which are asked again and again).
 pub(crate) fn mapped_bytes(at: *const u8, len: usize) -> u64 {
-    use windows_sys::Win32::System::Memory::{MEM_COMMIT, MEMORY_BASIC_INFORMATION, VirtualQuery};
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEMORY_BASIC_INFORMATION, PAGE_GUARD, PAGE_NOACCESS, VirtualQuery,
+    };
     if len == 0 {
         return 0;
     }
@@ -1798,10 +1800,16 @@ pub(crate) fn mapped_bytes(at: *const u8, len: usize) -> u64 {
     {
         return there;
     }
-    if !committed(at, 1) && !committed((end - 1) as *const u8, 1) {
+    // Neither end there: none, for a texture of a page or two. A longer one
+    // can be streaming with only its middle levels mapped, so the host is
+    // asked for the runs between (they came out as none and the texture
+    // stayed black; DexNom/VIctory 921d8d3b).
+    let query = by_query();
+    let ends_missing = !query && !committed(at, 1) && !committed((end - 1) as *const u8, 1);
+    if ends_missing && (end - 1) / 4096 - start / 4096 <= 1 {
         return 0;
     }
-    if !by_query() {
+    if !query && !ends_missing {
         static BY_PAGE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
         if *BY_PAGE.get_or_init(|| std::env::var_os("VICTORY_MAPPED_BY_PAGE").is_some_and(|v| v == "1")) {
             // By page, without the walk: whole pages, cut to the range.
@@ -1838,7 +1846,9 @@ pub(crate) fn mapped_bytes(at: *const u8, len: usize) -> u64 {
         if n == 0 || next <= p {
             break;
         }
-        if info.State == MEM_COMMIT {
+        // Committed but not readable (a guard or no-access page) has no
+        // texels to stage.
+        if info.State == MEM_COMMIT && info.Protect & (PAGE_NOACCESS | PAGE_GUARD) == 0 {
             there += (next - p) as u64;
         }
         p = next;
@@ -1964,6 +1974,24 @@ fn staging(resource: This, copy: &crate::resource::HostTexture, first: u32) -> O
 mod title_memory_tests {
     use super::with_title;
 
+    #[test]
+    fn a_texture_with_only_interior_pages_counts_its_resident_bytes() {
+        use windows_sys::Win32::System::Memory::*;
+        const BLOCK: usize = 64 << 10;
+        // SAFETY: this private reservation is ours throughout the test.
+        unsafe {
+            let base = VirtualAlloc(std::ptr::null(), 5 * BLOCK, MEM_RESERVE, PAGE_NOACCESS).cast::<u8>();
+            assert!(!base.is_null());
+            let middle = base.add(2 * BLOCK);
+            assert_eq!(VirtualAlloc(middle.cast(), BLOCK, MEM_COMMIT, PAGE_READWRITE), middle.cast());
+            assert_eq!(super::mapped_bytes(base, 5 * BLOCK), BLOCK as u64);
+            assert_eq!(super::mapped_bytes(base.add(BLOCK - 3), 2 * BLOCK + 9), BLOCK as u64);
+            assert_eq!(super::mapped_bytes(base, 2 * BLOCK), 0);
+            assert_ne!(VirtualFree(middle.cast(), BLOCK, MEM_DECOMMIT), 0);
+            assert_eq!(super::mapped_bytes(base, 5 * BLOCK), 0);
+            assert_ne!(VirtualFree(base.cast(), 0, MEM_RELEASE), 0);
+        }
+    }
     #[test]
     fn a_zero_sparse_read_keeps_the_digest_of_the_staged_texels() {
         use super::{Last, digest};
