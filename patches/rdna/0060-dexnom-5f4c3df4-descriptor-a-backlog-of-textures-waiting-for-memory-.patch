From 9b0b2677a08c3f209a513d278e3da974f71a5f72 Mon Sep 17 00:00:00 2001
From: kalaga <kalaga@localhost>
Date: Fri, 27 Nov 2026 12:42:12 -0500
Subject: [PATCH] descriptor: a backlog of textures waiting for memory leaves
 room for new ones

The texture pass served every slot looked at before (memory not there
yet, or only part) ahead of every slot never looked at. While a city
streams in, those can outnumber a pass, and a texture written since
waited for as long as the backlog lasted: black or low-detail surfaces.
With both kinds waiting, the looks again now take at most half of a
pass and the two take turns, a look again first; with room for all of
them the pass serves all of them as before.

After DexNom/VIctory 5f4c3df4 ('Improve City texture streaming'), which
alternates the two classes the same way on the victory-world tree.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G6tkVHCftUUQbGm5NirGaG
---
 crates/victory-gpu/src/descriptor/host.rs | 80 +++++++++++++++++------
 1 file changed, 61 insertions(+), 19 deletions(-)

diff --git a/crates/victory-gpu/src/descriptor/host.rs b/crates/victory-gpu/src/descriptor/host.rs
index 29044fdd..c0d4e82e 100644
--- a/crates/victory-gpu/src/descriptor/host.rs
+++ b/crates/victory-gpu/src/descriptor/host.rs
@@ -1210,14 +1210,19 @@ impl TextureQueue {
 
     /// Up to `max` slots due at `frame`, each with its write number, in
     /// the order to serve them:
-    /// - first the ones looked at before (their memory was not mapped, or
-    ///   only part of it): the look is a query, and memory that has
-    ///   arrived since is what the title streamed in last;
-    /// - then the others, the newest write first and the oldest next, in
-    ///   turns: slot order served the low slots of a backlog of
-    ///   25,000-40,000 while the textures of the shot on screen waited
-    ///   (run 52: 98% of the drawn pixels had no colour texture in the
-    ///   first 3D frames).
+    /// - the ones looked at before (their memory was not mapped, or only
+    ///   part of it), newest first: the look is a query, and memory that
+    ///   has arrived since is what the title streamed in last;
+    /// - the others, the newest write first and the oldest next, in turns:
+    ///   slot order served the low slots of a backlog of 25,000-40,000
+    ///   while the textures of the shot on screen waited (run 52: 98% of
+    ///   the drawn pixels had no colour texture in the first 3D frames);
+    /// - the two classes in turns, a look again first, and with both
+    ///   waiting the looks again take at most half of a pass: served all
+    ///   first, a backlog of textures whose memory is not there yet (a
+    ///   city streaming in) took every pass and a texture written since
+    ///   was never made (after DexNom/VIctory 5f4c3df4). With room for all
+    ///   of them the pass serves all of them, as before.
     #[cfg(test)]
     fn due(&self, frame: u64, max: usize) -> Vec<(u32, u64)> {
         Self::in_order(self.all_due(frame), max)
@@ -1238,9 +1243,12 @@ impl TextureQueue {
         if max == 0 {
             return Vec::new();
         }
-        if again.len() > max {
-            again.select_nth_unstable_by(max, newest_first);
-            again.truncate(max);
+        // The looks again's share: all of the pass with nothing fresh,
+        // else at least half of it and whatever the fresh leave.
+        let share = if fresh.is_empty() { max } else { max.div_ceil(2).max(max.saturating_sub(fresh.len())) };
+        if again.len() > share {
+            again.select_nth_unstable_by(share, newest_first);
+            again.truncate(share);
         }
         again.sort_unstable_by(newest_first);
         let take = (max - again.len()).min(fresh.len());
@@ -1263,13 +1271,25 @@ impl TextureQueue {
             oldest.sort_unstable_by(newest_first);
             (newest, oldest)
         };
-        again.reserve(take);
+        let mut fresh_order = Vec::with_capacity(take);
         let mut oldest = oldest.iter().rev();
         for &entry in newest.iter() {
-            again.push(entry);
-            again.extend(oldest.next().copied());
+            fresh_order.push(entry);
+            fresh_order.extend(oldest.next().copied());
+        }
+        // In turns, a look again first: a pass cut short by its time
+        // still served both classes.
+        let mut order = Vec::with_capacity(again.len() + fresh_order.len());
+        let (mut again, mut fresh) = (again.into_iter(), fresh_order.into_iter());
+        loop {
+            let (a, f) = (again.next(), fresh.next());
+            if a.is_none() && f.is_none() {
+                break;
+            }
+            order.extend(a);
+            order.extend(f);
         }
-        again
+        order
     }
 
     /// The entry of `index` if it is still the write the pass was handed.
@@ -6081,14 +6101,36 @@ mod tests {
     }
 
     #[test]
-    fn limited_texture_passes_match_the_full_order() {
+    fn limited_texture_passes_share_between_looks_again_and_fresh_slots() {
         let fresh = vec![(2, 4), (3, 8), (5, 1), (1, 6), (4, 2), (8, 10), (9, 3)];
         let again = vec![(6, 7), (7, 5), (0, 9)];
-        let full = [(0, 9), (6, 7), (7, 5), (8, 10), (5, 1), (3, 8), (4, 2), (1, 6), (9, 3), (2, 4)];
+        // Room for all: every slot, the two classes in turns.
+        let full = [(0, 9), (8, 10), (6, 7), (5, 1), (7, 5), (3, 8), (4, 2), (1, 6), (9, 3), (2, 4)];
+        assert_eq!(TextureQueue::in_order([again.clone(), fresh.clone()], 100), full);
         for max in 0..=full.len() + 1 {
             let ordered = TextureQueue::in_order([again.clone(), fresh.clone()], max);
-            assert_eq!(ordered.as_slice(), &full[..max.min(full.len())]);
-        }
+            assert_eq!(ordered.len(), max.min(full.len()), "{max}");
+            let looks = ordered.iter().filter(|e| again.contains(e)).count();
+            let share = max.div_ceil(2).max(max.saturating_sub(fresh.len()));
+            assert_eq!(looks, again.len().min(share), "{max}");
+            // The newest look again leads; the fresh served are the newest and oldest.
+            if max > 0 {
+                assert_eq!(ordered[0], (0, 9));
+            }
+            if max > 1 {
+                assert_eq!(ordered[1], (8, 10));
+            }
+            let mut unique = ordered.clone();
+            unique.sort_unstable();
+            unique.dedup();
+            assert_eq!(unique.len(), ordered.len());
+        }
+        // A backlog of looks again larger than a pass leaves room for fresh slots.
+        let backlog: Vec<(u32, u64)> = (100..200).map(|i| (i, u64::from(i))).collect();
+        let ordered = TextureQueue::in_order([backlog, fresh.clone()], 10);
+        assert_eq!(ordered.iter().filter(|e| fresh.contains(e)).count(), 5);
+        // Nothing fresh: the whole pass goes to the looks again.
+        assert_eq!(TextureQueue::in_order([again.clone(), Vec::new()], 2), [(0, 9), (6, 7)]);
     }
 
     /// Slots held back for lack of room on the card are not handed out
