+/// Host GPU virtual address of a whole 64 KiB page at `offset` in a copy
+/// starting at `copy_gpu_start` of length `copy_len`, or `0` if the page is
+/// partial, overflows, is unaligned for 64-byte BVH nodes, or resolves to 0.
+fn page_va(copy_gpu_start: u64, copy_len: u64, offset: u64) -> u64 {
+    if !offset.checked_add(PAGE).is_some_and(|end| end <= copy_len) {
+        return 0;
+    }
+    let va = copy_gpu_start.wrapping_add(offset);
+    if va == 0 || va & 63 != 0 {
+        return 0;
+    }
+    va
+}
+
 /// The bytes of a packed structure whose first two dwords these are: the
 /// version (6) with the marks of a bottom level and of one that is packed,
 /// and its size unpacked in 64-byte nodes.
@@ -1065,6 +1146,7 @@ pub(crate) fn ready(
     let directory = &m.directory.1;
     Some(Ready {
         directory: directory.gpu(directory.span().0),
+        vas: m.vas.as_ref().map(|(_, v)| v.gpu(v.span().0)),
         faults: m.faults.2,
         base,
     })
@@ -1301,4 +1383,22 @@ mod tests {
         assert_eq!(packed_len(header(0x8102_0006, 0)), None);
         assert_eq!(packed_len(header(0x8102_0006, 1 << 21)), None);
     }
+
+    #[test]
+    fn page_va_requires_whole_aligned_page() {
+        let base = 0x1_0000_0000u64;
+        // Whole 64 KiB pages aligned to 64 bytes yield their host GPU VA.
+        assert_eq!(page_va(base, 2 * PAGE, 0), base);
+        assert_eq!(page_va(base, 2 * PAGE, PAGE), base + PAGE);
+        assert_eq!(page_va(base, PAGE + 64, 64), base + 64);
+        // Partial or overflowing pages fall back to 0.
+        assert_eq!(page_va(base, PAGE - 1, 0), 0);
+        assert_eq!(page_va(base, PAGE + 64, 128), 0);
+        assert_eq!(page_va(base, 2 * PAGE, u64::MAX), 0);
+        // Unaligned pages (< 64-byte alignment) fall back to 0.
+        assert_eq!(page_va(base + 32, 2 * PAGE, 0), 0);
+        assert_eq!(page_va(base, 2 * PAGE, 32), 0);
+        // Zero VA falls back to 0.
+        assert_eq!(page_va(0, PAGE, 0), 0);
+    }
 }
