+/// Builds the user-data constants for an `intersect_tests` shader (table at
+/// heap index 0, `USER_MEMORY_BASE` at slot 2).
+fn hw_user_data(shader: &HostShader) -> Vec<u32> {
+    let mut ud = vec![0u32; shader.user_data_dwords().max(5) as usize];
+    for u in &shader.user_data {
+        ud[u.index as usize] = match u.root {
+            RootType::Table => 0,
+            RootType::Constants => 0,
+            RootType::Other(k) if k == super::USER_MEMORY_BASE => 2,
+            other => panic!("unexpected user_data entry: {other:?}"),
+        };
+    }
+    ud
+}
