+    let desc32_sorted = Descriptor::Numbers(
+        (structure >> 8) as u32,
+        (structure >> 40) as u32 | bvh::BOX_SORT,
+    );
+    let (scene, batches) = scene();
+
+    for (label, wide, descriptor, pointers, sort) in [
+        ("bvh64-sorted", true, WHOLE, HW_BASE + u64::from(NODES), true),
+        ("bvh32-sorted", false, desc32_sorted, 0, true),
+        ("bvh32-unsorted", false, desc32_unsorted, 0, false),
+    ] {
+        let (shader, _) = build(wide, descriptor).expect("hw bvh shader lowers");
+        assert!(shader.root_srvs.contains(&super::SLOT_MEMORY_VAS));
+        assert!(shader.root_uavs.contains(&super::SLOT_AMD_EXT));
+        let (root, pso) = host
+            .compute_pipeline(&shader)
+            .unwrap_or_else(|e| panic!("{label}: compute_pipeline failed: {e}"));
+        let ud = hw_user_data(&shader);
+        let (mut box_hits, mut tri_hits) = (0usize, 0usize);
+
+        for (b, batch) in batches.iter().enumerate() {
+            let mut data = buffer(&scene, batch, pointers);
+            // Pad to a full 64 KiB page so `MemoryVaTable` maps it whole.
+            let target_dwords = data.len().next_multiple_of(16_384).max(16_384);
+            data.resize(target_dwords, 0);
+            // Root params sorted by `(slot, kind)`:
+            // 0: UserData, 1: SLOT_MEMORY_VAS (252, SRV), 2: SLOT_AMD_EXT (252, UAV),
+            // 3: SLOT_FAULTS (253, UAV), 4: SLOT_MEMORY (254, SRV).
+            let roots = vec![
+                (0, Root::Constants(ud.clone())),
+                (
+                    1,
+                    Root::MemoryVaTable {
+                        first_page: FIRST_PAGE,
+                        view_index: 0,
+                    },
+                ),
+                (2, Root::Uav(1)),
+                (3, Root::Uav(super::MEMORY_FAULTS)),
+                (4, Root::View { srv: true, data: vec![0u32; 64] }),
+            ];
+            let out = host
+                .dispatch(
+                    &root,
+                    &pso,
+                    &Dispatch {
+                        roots,
+                        views: &[
+                            View::Buffer {
+                                data: &data,
+                                stride: Stride::Raw,
+                            },
+                            View::RawUav(4 * THREADS),
+                            View::RawUav(16),
+                        ],
+                        samplers: &[],
+                        groups: [1, 1, 1],
+                    },
+                )
+                .unwrap_or_else(|e| panic!("{label}: dispatch batch {b} failed: {e}"));
+
+            for t in 0..THREADS as usize {
+                let case = batch.get(t).copied().flatten();
+                let want = match batch.get(t) {
+                    Some(c) => expected(&scene, c, sort),
+                    None => BEFORE,
+                };
+                let got = &out[0][4 * t..4 * t + 4];
+                match case {
+                    None => {
+                        assert_eq!(got, want, "{label} batch {b} thread {t}: masked lane changed");
+                    }
+                    Some((node_idx, kind @ 0..=3, _)) => {
+                        let w_f = want.map(f32::from_bits);
+                        let g_f = [got[0], got[1], got[2], got[3]].map(f32::from_bits);
+                        let w_t = w_f[0] / w_f[1];
+                        let g_t = g_f[0] / g_f[1];
+                        let w_hit = w_t.is_finite();
+                        let g_hit = g_t.is_finite();
+                        if w_hit && g_hit {
+                            // `bvh::triangle_vertices` reorders `[v0, v1, v2]` to `[first, i, j]`,
+                            // flipping `det`'s sign on odd permutations (e.g. `i=2, j=1`).
+                            // Real RDNA 2 hardware preserves `[v0, v1, v2]` winding and only
+                            // permutes which barycentric channels are returned.
+                            let id = scene.node(node_idx)[15] >> (8 * kind);
+                            let (vi, vj) = (id & 3, (id >> 2) & 3);
+                            let first = 3u32.wrapping_sub(vi).wrapping_sub(vj) & 3;
+                            let odd_perm = (first + 1) % 3 != vi;
+                            let expected_positive = w_f[1].is_sign_positive() ^ odd_perm;
+                            assert_eq!(
+                                g_f[1].is_sign_positive(),
+                                expected_positive,
+                                "{label} b={b} t={t} kind={kind}: face sign mismatch (odd_perm={odd_perm}) got={g_f:?} want={w_f:?}"
+                            );
+                            let rel = |a: f32, b: f32| (a - b).abs() <= 1e-4 * b.abs().max(1.0);
+                            assert!(
+                                rel(g_t, w_t)
+                                    && rel(g_f[2] / g_f[1], w_f[2] / w_f[1])
+                                    && rel(g_f[3] / g_f[1], w_f[3] / w_f[1]),
+                                "{label} b={b} t={t} kind={kind}: triangle mismatch got={g_f:?} want={w_f:?}"
+                            );
+                            tri_hits += 1;
+                        } else if w_hit != g_hit {
+                            let (t_i, t_j) = if w_hit {
+                                (w_f[2] / w_f[1], w_f[3] / w_f[1])
+                            } else {
+                                (g_f[2] / g_f[1], g_f[3] / g_f[1])
+                            };
+                            let min_b = t_i.min(t_j).min(1.0 - t_i - t_j);
+                            assert!(
+                                min_b.abs() < 1e-3,
+                                "{label} b={b} t={t} kind={kind}: triangle hit mismatch got={g_f:?} want={w_f:?}"
+                            );
+                        }
+                    }
+                    Some((node_idx, kind @ (4 | 5), ray)) => {
+                        if got != want {
+                            let mut g_sorted = got.to_vec();
+                            let mut w_sorted = want.to_vec();
+                            g_sorted.sort_unstable();
+                            w_sorted.sort_unstable();
+                            if g_sorted != w_sorted {
+                                // RDNA 2/3/4 hardware `image_bvh*_intersect_ray` uses an
+                                // inclusive `enter <= ray.extent` (and hardware-specific
+                                // degenerate 0-direction handling), whereas the software
+                                // reference uses strict `<`. Verify every extra/missing
+                                // child sits on the exact `extent` boundary or has a
+                                // zero ray direction.
+                                let words = scene.node(node_idx);
+                                let boxes = if kind == 5 {
+                                    bvh::boxes32(&words)
+                                } else {
+                                    bvh::boxes16(&words)
+                                };
+                                let boundary_or_zero = ray.direction == [0.0; 3]
+                                    || (0..4).any(|k| {
+                                        let bx = boxes[k];
+                                        if bx[0].is_nan() {
+                                            return false;
+                                        }
+                                        // Grazing face with zero ray direction (`0 * inf` -> NaN in RDNA2 HW
+                                        // vs clamped `f32::MAX` in software reference).
+                                        let grazing = (0..3).any(|a| {
+                                            ray.direction[a] == 0.0
+                                                && (bx[a] == ray.origin[a]
+                                                    || bx[3 + a] == ray.origin[a])
+                                        });
+                                        if grazing {
+                                            return true;
+                                        }
+                                        let mut enter = f32::NEG_INFINITY;
+                                        for a in 0..3 {
+                                            let inv = ray.inverse[a].clamp(-f32::MAX, f32::MAX);
+                                            let l = (bx[a] - ray.origin[a]) * inv;
+                                            let h = (bx[3 + a] - ray.origin[a]) * inv;
+                                            enter = enter.max(l.min(h));
+                                        }
+                                        (enter - ray.extent).abs() <= 1e-4 * ray.extent.abs().max(1.0)
+                                    });
+                                assert!(
+                                    boundary_or_zero,
+                                    "{label} b={b} t={t} kind={kind}: box mismatch got={got:08x?} want={want:08x?} ray={ray:?}"
+                                );
+                            }
+                        }
+                        box_hits += want.iter().filter(|&&c| c != bvh::NONE).count();
+                    }
+                    Some((_, kind, _)) => {
+                        assert_eq!(
+                            got, want,
+                            "{label} b={b} t={t} kind={kind}: non-box/tri mismatch"
+                        );
+                    }
+                }
+            }
+        }
+        assert!(box_hits > 100 && tri_hits > 50, "{label}: too few hits ({box_hits}, {tri_hits})");
+        eprintln!(
+            "AMD HW BVH {label} (opcode={:#04x}, support={:#04x}): PASS ({box_hits} box hits, {tri_hits} triangle hits)",
+            guard.opcode, guard.support_code
+        );
+    }
+    drop(guard);
+}
+
+/// Standalone GPU throughput benchmark comparing software `image_bvh64_intersect_ray`
+/// against hardware `IntersectBvhNode` (`opcode 0x22`) on a live AMD GPU.
+///
+/// Run with:
+/// `VICTORY_D3D12_ADAPTER=AMD cargo +stable test --locked -p victory-shader --features host --lib amd_hw_bvh_throughput_benchmark -- --ignored --nocapture --test-threads=1`
+#[test]
+#[ignore]
+fn amd_hw_bvh_throughput_benchmark() {
+    use std::time::Instant;
+
+    let _one = super::valu_tests::ONE_AT_A_TIME
+        .lock()
+        .unwrap_or_else(|e| e.into_inner());
+    let Ok(host) = Host::new(false) else {
+        eprintln!("no SM 6.6 hardware device; skipped");
+        return;
+    };
+    let adapter = host.adapter_name().unwrap_or_else(|| "unknown".into());
+    let Some(guard) = super::host::enable_amd_bvh(&host.device) else {
+        eprintln!("AMD IntersectBvhNode extension unavailable on {adapter}; skipped");
+        return;
+    };
+    let _reset = HwBvhReset;
+
+    const HW_BASE: u64 = 0x1_0000_0000;
+    const FIRST_PAGE: usize = (HW_BASE >> 16) as usize;
+    let (scene, batches) = scene();
+    // Build a representative 32-lane mixed box32/box16/triangle batch.
+    let mut mixed: Vec<Case> = Vec::with_capacity(THREADS as usize);
+    for c in batches.iter().flatten() {
+        if matches!(c, Some((_, 4 | 5, _))) && mixed.len() < 16 {
+            mixed.push(*c);
+        }
+    }
+    for c in batches.iter().flatten() {
+        if matches!(c, Some((_, 0..=3, _))) && mixed.len() < THREADS as usize {
+            mixed.push(*c);
+        }
+    }
+    let mut data = buffer(&scene, &mixed, HW_BASE + u64::from(NODES));
+    data.resize(data.len().next_multiple_of(16_384).max(16_384), 0);
+
+    // 65,535 * 64 * 32 = 134,215,680 ray-node tests per dispatch (well under TDR,
+    // large enough that GPU execution dominates setup).
+    let groups = [65_535u32, 64, 1];
+    let total_rays = u64::from(groups[0]) * u64::from(groups[1]) * u64::from(THREADS);
+
+    let bench = |hw_opcode: u8| -> (f64, f64) {
+        let _mem = if hw_opcode == 0 {
+            Some(Memory::at(HW_BASE))
+        } else {
+            None
+        };
+        super::lower::TEST_HW_BVH.set(Some(hw_opcode));
+        let (shader, _) = build(true, WHOLE).expect("bench shader lowers");
+        let (root, pso) = host.compute_pipeline(&shader).expect("compute_pipeline");
+        let ud = hw_user_data(&shader);
+        let make_roots = || {
+            if hw_opcode != 0 {
+                vec![
+                    (0, Root::Constants(ud.clone())),
+                    (
+                        1,
+                        Root::MemoryVaTable {
+                            first_page: FIRST_PAGE,
+                            view_index: 0,
+                        },
+                    ),
+                    (2, Root::Uav(1)),
+                    (3, Root::Uav(super::MEMORY_FAULTS)),
+                    (4, Root::View { srv: true, data: vec![0u32; 64] }),
+                ]
+            } else {
+                vec![(0, Root::Constants(ud.clone()))]
+            }
+        };
+        let views = [
+            View::Buffer {
+                data: &data,
+                stride: Stride::Raw,
+            },
+            View::RawUav(4 * THREADS),
+            View::RawUav(16),
+        ];
+        // Warmup + measure baseline 1-group dispatch setup overhead (includes VA table upload).
+        host.dispatch(
+            &root,
+            &pso,
+            &Dispatch {
+                roots: make_roots(),
+                views: &views,
+                samplers: &[],
+                groups: [1, 1, 1],
+            },
+        )
+        .expect("warmup");
+        let mut overhead = Vec::with_capacity(3);
+        for _ in 0..3 {
+            let t0 = Instant::now();
+            host.dispatch(
+                &root,
+                &pso,
+                &Dispatch {
+                    roots: make_roots(),
+                    views: &views,
+                    samplers: &[],
+                    groups: [1, 1, 1],
+                },
+            )
+            .expect("overhead");
+            overhead.push(t0.elapsed().as_secs_f64() * 1000.0);
+        }
+        overhead.sort_by(f64::total_cmp);
+        let setup_ms = overhead[overhead.len() / 2];
+
+        let mut samples = Vec::with_capacity(5);
+        for _ in 0..5 {
+            let t0 = Instant::now();
+            host.dispatch(
+                &root,
+                &pso,
+                &Dispatch {
+                    roots: make_roots(),
+                    views: &views,
+                    samplers: &[],
+                    groups,
+                },
+            )
+            .expect("bench dispatch");
+            samples.push(t0.elapsed().as_secs_f64() * 1000.0);
+        }
+        samples.sort_by(f64::total_cmp);
+        let total_ms = samples[samples.len() / 2];
+        (total_ms, (total_ms - setup_ms).max(0.01))
+    };
+
+    let (sw_total, sw_gpu) = bench(0);
+    let (hw_total, hw_gpu) = bench(guard.opcode);
+    eprintln!(
+        "AMD HW BVH64 throughput ({adapter}, {total_rays} ray-node tests, median of 5):\n  software (direct TEST_MEMORY): total={sw_total:.2} ms, gpu={sw_gpu:.2} ms ({:.1} Mrays/s)\n  hardware (IntersectBvhNode opcode={:#04x}, support={:#04x}): total={hw_total:.2} ms, gpu={hw_gpu:.2} ms ({:.1} Mrays/s)\n  speedup: total={:.2}x, gpu={:.2}x",
+        (total_rays as f64) / (sw_gpu * 1e3),
+        guard.opcode,
+        guard.support_code,
+        (total_rays as f64) / (hw_gpu * 1e3),
+        sw_total / hw_total,
+        sw_gpu / hw_gpu,
+    );
+    drop(guard);
+}
