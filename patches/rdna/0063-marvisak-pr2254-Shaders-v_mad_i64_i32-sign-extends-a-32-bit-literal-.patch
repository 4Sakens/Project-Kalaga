From 54381d60fd69c70cd057888918532d5866967760 Mon Sep 17 00:00:00 2001
From: BastienRdz <58186763+BastienRodz@users.noreply.github.com>
Date: Wed, 25 Nov 2026 08:57:29 +0000
Subject: [PATCH 63/63] Shaders: v_mad_i64_i32 sign-extends a 32-bit literal
 addend

src64 sign-extends a literal for operations named *_i64 (#447), but
v_mad_i64_i32's addend is S2.i64 too, and its name ends in _i32, so a
negative literal there was zero-extended: 0 * 0 + -100 gave 0xffffff9c
with a high dword of 0. RDNA 2 ISA 6.2.1: a 64-bit signed integer source
sign-extends its literal. v_mad_u64_u32 keeps zero-extending.

Co-Authored-By: Gemini 4 Neon <noreply@google.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 5a8a792961896867bab9f27e1b38397c1c5ef9b2)
---
 crates/victory-shader/src/emit/lower.rs      |  4 ++-
 crates/victory-shader/src/emit/valu_tests.rs | 33 ++++++++++++++++++++
 2 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index a6d7ba3b..32afbbb7 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -9788,7 +9788,9 @@ impl<'a> Lower<'a> {
             }
             // A signed 64-bit operand sign-extends its 32-bit literal, as
             // the hardware does (LLVM's AMDGPU operand rules).
-            Operand::Literal(x) if inst.name().ends_with("_i64") => {
+            Operand::Literal(x)
+                if inst.name().ends_with("_i64") || inst.name() == "v_mad_i64_i32" =>
+            {
                 Ok(self.s.m.int_const(i64t, i64::from(x as i32)))
             }
             _ => {
diff --git a/crates/victory-shader/src/emit/valu_tests.rs b/crates/victory-shader/src/emit/valu_tests.rs
index 70598b0a..811cd193 100644
--- a/crates/victory-shader/src/emit/valu_tests.rs
+++ b/crates/victory-shader/src/emit/valu_tests.rs
@@ -1356,6 +1356,39 @@ fn signed_64_bit_operands_sign_extend_their_literal() {
     check("s_ashr_i64", &ashr, &[([0; 4], u32::MAX)]);
 }
 
+/// `v_mad_i64_i32` sign-extends a 32-bit literal in `src2` (`S2.i64`), while
+/// `v_mad_u64_u32` zero-extends it (`S2.u64`).
+#[test]
+fn mad_i64_i32_sign_extends_literal_addend() {
+    const MINUS_100: u32 = -100_i32 as u32;
+    // VOP3B `v_mad_* v[5:6], s6, v1, v2, -100`; return the high dword `v6`.
+    let high_dword = |op: u16| {
+        let [a, b] = vop3(op, 5, vgpr(1), vgpr(2), 255);
+        [a | 6 << 8, b, MINUS_100, vop1(0x001, 0, vgpr(6))]
+    };
+    let check = |name: &str, op: u16, cases: &[([u32; 4], u32)]| {
+        let shader = build_valu_cs(&high_dword(op));
+        let inputs: Vec<[u32; 4]> = cases.iter().map(|c| c.0).collect();
+        run_cases(&shader, &inputs, |backend, i, inp, got| {
+            assert_eq!(got, cases[i].1, "{backend}: {name} {inp:x?}");
+        });
+    };
+    check(
+        "v_mad_i64_i32",
+        0x177,
+        &[
+            ([0, 0, 0, 0], u32::MAX),
+            ([10, 10, 0, 0], 0),
+            ([(-100_000_i32) as u32, 100_000, 0, 0], 0xFFFF_FFFD),
+        ],
+    );
+    check(
+        "v_mad_u64_u32",
+        0x176,
+        &[([0, 0, 0, 0], 0), ([10, 10, 0, 0], 1)],
+    );
+}
+
 #[test]
 fn bfe_signed_and_unsigned_match_rdna2() {
     // v_bfe_i32 v0, v1, v2, v3 (VOP3 opcode 0x149)
