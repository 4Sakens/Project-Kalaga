+/// Writes every `(rva, old, new)` of `patches` into the image of `size`
+/// bytes at `base`, only if every `old` is what is there (all or nothing:
+/// another build of the title is left as it is). `Err` says which differs.
+///
+/// # Safety
+/// The image stays mapped and no thread runs its code yet.
+#[cfg(windows)]
+pub unsafe fn write_all_checked(base: usize, size: usize, patches: &[(u32, Vec<u8>, Vec<u8>)]) -> Result<(), String> {
+    for (rva, old, new) in patches {
+        let at = *rva as usize;
+        if new.len() > old.len() || at.checked_add(old.len()).is_none_or(|end| end > size) {
+            return Err(format!("+{rva:#x}: outside the image or longer than the bytes compared"));
+        }
+        // SAFETY: inside the mapped image (checked above).
+        let there = unsafe { std::slice::from_raw_parts((base + at) as *const u8, old.len()) };
+        if there != &old[..] {
+            return Err(format!("+{rva:#x}: the title's bytes there are not the ones expected (another build?)"));
+        }
+    }
+    for (rva, old, new) in patches {
+        let site = Site { at: *rva as usize, what: "checked patch", bytes: old.clone().leak() };
+        // SAFETY: the caller's promise; compared above.
+        match unsafe { write(base, size, &site, new) } {
+            Patched::Done => {}
+            other => return Err(format!("+{rva:#x}: {other:?}")),
+        }
+    }
+    Ok(())
+}
+
 /// Applies what the switches ask for; a line each in the log and on
 /// standard output.
 ///
