From ccd635b1007c0a365152975119e94c4b789f6ba9 Mon Sep 17 00:00:00 2001
From: "Claude (XboxCompat)" <local@invalid>
Date: Fri, 27 Nov 2026 11:18:18 -0500
Subject: [PATCH 75/76] Shaders: v_writelane_b32 takes its lane from S1[4:0]
 (wave32) or S1[5:0] (wave64)

A lane select past the wave (33 in a 32-lane wave) matched no console lane, so
the write was lost; the console writes lane 1. The select is masked to the
wave as the ISA does. v_readlane_b32 already wrapped on the host; the new test
lane_selects_past_the_wave_wrap covers both. Independent implementation from
the ISA.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/victory-shader/src/emit/lower.rs      |  4 +++
 crates/victory-shader/src/emit/valu_tests.rs | 26 ++++++++++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index 4302eb30..6203d678 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -9833,6 +9833,10 @@ impl<'a> Lower<'a> {
                     return Err("a lane write in a half-wave");
                 }
                 let me = self.console_lane();
+                // The lane is S1[4:0] in a 32-lane wave, S1[5:0] in a 64-lane one (T-0046):
+                // a select past the wave wraps instead of writing no lane.
+                let wrap = self.s.m.i32(self.wave() - 1);
+                let lane = self.s.m.bin(c, Bin::And, lane, wrap);
                 let is = self.s.m.cmp(c, pred::EQ, me, lane);
                 let r = self.s.m.select(c, is, a, old);
                 int(self, r)
diff --git a/crates/victory-shader/src/emit/valu_tests.rs b/crates/victory-shader/src/emit/valu_tests.rs
index 811cd193..56b9e2bd 100644
--- a/crates/victory-shader/src/emit/valu_tests.rs
+++ b/crates/victory-shader/src/emit/valu_tests.rs
@@ -605,6 +605,32 @@ fn v_permlane16_and_x16_read_the_lanes_their_selectors_pick() {
     }
 }
 
+/// `v_readlane_b32` / `v_writelane_b32` take the lane from S1[4:0] in a
+/// 32-lane wave (S1[5:0] in a 64-lane one): lane 33 is lane 1.
+/// (XboxCompatibility T-0046, original test.)
+#[test]
+fn lane_selects_past_the_wave_wrap() {
+    let readlane = |sdst: u32, vsrc: u32, lane: u32| [0xD760_0000 | sdst, (128 + lane) << 9 | (256 + vsrc)];
+    let writelane = |vdst: u32, ssrc: u32, lane: u32| [0xD761_0000 | vdst, (128 + lane) << 9 | ssrc];
+    // v0 holds each lane's number: lane 33 reads lane 1's.
+    let mut read = Vec::new();
+    read.extend_from_slice(&readlane(12, 0, 33));
+    read.push(vop1(0x001, 0, sgpr(12))); // v_mov_b32 v0, s12
+    let shader = build_cs(&read, 32, 0);
+    run_cases_on(&shader, &[[0; 4]], &[("hardware", false)], |backend, _, _, got| {
+        assert_eq!(got, 1, "{backend}: v_readlane_b32 of lane 33 in a 32-lane wave");
+    });
+    // A write to lane 33 lands in lane 1.
+    let mut write = vec![s_mov_b32(12, 128 + 7), vop1(0x001, 1, 128)]; // s12 = 7; v1 = 0
+    write.extend_from_slice(&writelane(1, 12, 33));
+    write.extend_from_slice(&readlane(13, 1, 1));
+    write.push(vop1(0x001, 0, sgpr(13))); // v_mov_b32 v0, s13
+    let shader = build_cs(&write, 32, 0);
+    run_cases_on(&shader, &[[0; 4]], &[("hardware", false)], |backend, _, _, got| {
+        assert_eq!(got, 7, "{backend}: v_writelane_b32 to lane 33 in a 32-lane wave");
+    });
+}
