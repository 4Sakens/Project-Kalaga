From 0f1b988dd0112dba3bcc365edd5a79398d210dff Mon Sep 17 00:00:00 2001
From: EatCodeSleep2 <52021568+EatCodeSleep2@users.noreply.github.com>
Date: Tue, 24 Nov 2026 09:58:27 -0800
Subject: [PATCH 74/76] Shaders: preserve the unwritten high half of packed D16
 image loads

---
 crates/victory-shader/src/emit/lower.rs       |  7 ++-
 .../src/emit/waterfall_tests.rs               | 46 ++++++++++++++++++-
 2 files changed, 49 insertions(+), 4 deletions(-)

diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index 4593c318..4302eb30 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -12593,15 +12593,18 @@ impl<'a> Lower<'a> {
             });
         }
         if *d16 {
-            // Two channels per VGPR, low half first (an odd last high half 0).
+            // Two channels per VGPR, low half first.
             let k16 = self.s.m.i32(16);
             xs = xs
                 .chunks(2)
-                .map(|p| match *p {
+                .enumerate()
+                .map(|(k, p)| match *p {
                     [lo, hi] => {
                         let hi = self.s.m.bin(c, Bin::Shl, hi, k16);
                         self.s.m.bin(c, Bin::Or, lo, hi)
                     }
+                    // An odd image load only writes the last register's low half.
+                    [lo] if op == 66 => self.low_half(inst, reg + k as u8, lo),
                     _ => p[0],
                 })
                 .collect();
diff --git a/crates/victory-shader/src/emit/waterfall_tests.rs b/crates/victory-shader/src/emit/waterfall_tests.rs
index 85e2b1a1..0177170a 100644
--- a/crates/victory-shader/src/emit/waterfall_tests.rs
+++ b/crates/victory-shader/src/emit/waterfall_tests.rs
@@ -16,6 +16,10 @@ use crate::{io, ir, resource, structure};
 /// s0 (textures, or with `buffers` structured buffers of dwords, at entries
 /// 0 and 1, a raw UAV at entry 2) and the table of samplers at s1.
 fn build(words: &[u32], buffers: bool) -> HostShader {
+    build_with_handle_count(words, buffers, 1)
+}
+
+fn build_with_handle_count(words: &[u32], buffers: bool, nonuniform_handles: u32) -> HostShader {
     let table = |user_data: u8| RootParam {
         root: RootType::Table,
         table_offset_dwords: 0,
@@ -71,8 +75,7 @@ fn build(words: &[u32], buffers: bool) -> HostShader {
         mesh_stride: 0,
     })
     .expect("lower");
-    // One access with each lane's own heap index, no wave operation.
-    assert_eq!(lowered.nonuniform_handles, 1);
+    assert_eq!(lowered.nonuniform_handles, nonuniform_handles);
     assert!(!lowered.wave_ops);
     let shader = HostShader {
         stage: HwStage::Cs,
@@ -165,6 +168,45 @@ fn sampled(shader: &HostShader) -> Vec<(&'static str, Vec<f32>)> {
         .collect()
 }
 
+#[test]
+fn packed_image_load_keeps_unwritten_high_half() {
+    let texels = [[1.0, 2.0, 3.0, 4.0]];
+    let views = [
+        View::Texture(1, 1, &texels),
+        View::Texture(1, 1, &texels),
+        View::RawUav(32),
+    ];
+    for (dmask, reg, seed, want) in [
+        (1, 12, 0x5a5a_1234, 0x5a5a_3c00),
+        (3, 12, 0x5a5a_1234, 0x4000_3c00),
+        (7, 13, 0xdead_5678, 0xdead_4200),
+    ] {
+        let words = [
+            0xBE84_0300, // s_mov_b32 s4, s0
+            0xBE85_0380, // s_mov_b32 s5, 0
+            0xF408_0A02,
+            0xFA00_0040, // s_load_dwordx4 s[40:43], s[4:5], 0x40
+            0xF40C_0302,
+            0xFA00_0000, // s_load_dwordx8 s[12:19], s[4:5], 0
+            0x7E04_0280, // v_mov_b32 v2, 0
+            0x7E06_0280, // v_mov_b32 v3, 0
+            0x7E00_02FF | reg << 17,
+            seed, // v_mov_b32 v[reg], seed
+            0xF000_0008 | dmask << 8,
+            0x8003_0C02, // image_load v12..., v[2:3], s[12:19] dim:2D d16
+            0x3420_0082, // v_lshlrev_b32 v16, 2, v0
+            0xE070_1000,
+            0x800A_0010 | reg << 8, // buffer_store_dword v[reg], v16, s[40:43], 0 offen
+            0xBF81_0000, // s_endpgm
+        ];
+        let results = run(&build_with_handle_count(&words, false, 0), &views);
+        assert!(!results.is_empty(), "no SM 6.6 test adapter");
+        for (backend, got) in results {
+            assert_eq!(got, [want; 32], "{backend}: dmask {dmask:#x}");
+        }
+    }
+}
+
