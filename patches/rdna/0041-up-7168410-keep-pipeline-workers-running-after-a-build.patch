From 1bd939d7728f61d5c10e620057a86b7ee7c57581 Mon Sep 17 00:00:00 2001
From: Filip Michalski <37023444+Filip722@users.noreply.github.com>
Date: Fri, 27 Nov 2026 09:47:53 -0500
Subject: [PATCH] Keep pipeline workers running after a build panic

Ported from TaynanGT/Vice-Tay 7168410 onto VIctory-RDNA 68402ce, whose Pending::make no longer uses OnceLock::get_or_init (it skips keys the driver's compiler crashed on). The build of one pipeline is now inside catch_unwind: a panic is logged and that pipeline counts as not made, instead of ending the worker and leaving every later pipeline on it missing. Vice-Tay's make_with test is not carried over (it targets the old shape).
---
 crates/victory-gpu/src/pipeline/make.rs | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/crates/victory-gpu/src/pipeline/make.rs b/crates/victory-gpu/src/pipeline/make.rs
index d085a1f..039396b 100644
--- a/crates/victory-gpu/src/pipeline/make.rs
+++ b/crates/victory-gpu/src/pipeline/make.rs
@@ -22,6 +22,7 @@
 //! 18e57db8 found the same).
 
 use std::collections::VecDeque;
+use std::panic::{AssertUnwindSafe, catch_unwind};
 use std::sync::atomic::{AtomicBool, AtomicU8, AtomicU64, AtomicUsize, Ordering};
 use std::sync::{Arc, Condvar, Mutex, OnceLock};
 use std::time::{Duration, Instant};
@@ -91,7 +92,18 @@ impl Pending {
             } else {
                 let _building = crate::timeline::span("pipeline: build a host pipeline");
                 let began = Instant::now();
-                let made = HostPipeline::new(&self.shaders, self.graphics.as_deref());
+                // A panic while building one pipeline must not take its worker
+                // down with it: every later pipeline queued on that worker would
+                // stay missing for the rest of the session.
+                let made = match catch_unwind(AssertUnwindSafe(|| {
+                    HostPipeline::new(&self.shaders, self.graphics.as_deref())
+                })) {
+                    Ok(made) => made,
+                    Err(_) => {
+                        tracing::warn!(key = self.key, shaders = ?self.shaders, "host pipeline build panicked");
+                        None
+                    }
+                };
                 super::library::note_time(&self.key, began.elapsed().as_millis() as u64);
                 made
             };
