+/// Whether mono convolutions are computed (`VICTORY_DSP_CONVOLVE=0`: not).
+fn convolve_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_DSP_CONVOLVE").is_none_or(|v| v != "0"))
