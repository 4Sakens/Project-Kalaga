 crates/victory-gpu/src/draw.rs            |  7 ++
 crates/victory-gpu/src/residency.rs       |  8 ++
 crates/victory-gpu/src/resource.rs        | 93 +++++++++++++++++++++--
 4 files changed, 111 insertions(+), 7 deletions(-)

diff --git a/crates/victory-gpu/src/descriptor/host.rs b/crates/victory-gpu/src/descriptor/host.rs
index d714960..c6a3c2c 100644
--- a/crates/victory-gpu/src/descriptor/host.rs
+++ b/crates/victory-gpu/src/descriptor/host.rs
@@ -3674,6 +3674,14 @@ impl HostHeap {
                 self.keep(index, None);
             } else {
                 let kept = make_twinned(&view, self.at(index), self.twin(index));
+                // A texture the card had no memory for: the slot is not noted as
+                // made from this record, so the next ask makes it again (it kept
+                // its null view for good, avatarmanz/VIctory-7900XTX#256).
+                let retry = kept.is_none()
+                    && matches!(view, View::Shader(resource, _) if crate::resource::retrying(resource as crate::object::This));
+                if retry {
+                    self.made.set(index, 0);
+                }
                 if kept.is_none() {
                     if !self.sampler {
                         self.put_null_for(index, &view);
@@ -3683,7 +3691,7 @@ impl HostHeap {
                 }
                 self.twin_made(index, kept.is_some() && twinned(&view));
                 self.keep(index, kept.flatten());
-                self.quick_is(index, key);
+                self.quick_is(index, if retry { 0 } else { key });
             }
             drop(held);
             self.unmake_stale(index, stale);
diff --git a/crates/victory-gpu/src/draw.rs b/crates/victory-gpu/src/draw.rs
index 6952bbc..9b6be6a 100644
--- a/crates/victory-gpu/src/draw.rs
+++ b/crates/victory-gpu/src/draw.rs
@@ -2807,6 +2807,13 @@ impl State {
                 }
             };
             let texture = crate::resource::host_resource(resource);
+            // No host copy for want of the card's memory: the slot stays in
+            // the queue and is looked at again once the card may have room
+            // (marked done, it was never uploaded, avatarmanz/VIctory-7900XTX#256).
+            if texture.is_none() && crate::resource::retrying(resource) {
+                host.texture_slot_held(index, write, frame + 1);
+                continue;
+            }
             let title_fills = texture.is_some_and(crate::texture::title_written);
