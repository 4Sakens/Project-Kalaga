+                }
+                if key_down(0x02) {
+                    pad.left_trigger = 1.0; // RMB: Aim / Brake-Reverse (LT)
+                }
+                if key_down(0x04) {
+                    pad.buttons |= RIGHT_STICK; // MMB: Look behind / Special (R3)
+                }
+            }
+            pad
+        }
