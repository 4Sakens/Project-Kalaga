From b374b8413899d79b6c1360693d5886fa552d3e7d Mon Sep 17 00:00:00 2001
From: Matsvey Makushenka <matvey.myown@gmail.com>
Date: Fri, 27 Nov 2026 11:37:13 -0500
Subject: [PATCH 54/54] GPU: write a null CBV when CreateConstantBufferView
 gets a null desc

D3D12 accepts a null description as BufferLocation=0, SizeInBytes=0.
create_cbv returned early instead, so the slot kept the view written
there before: a draw reading it read another buffer's constants.

(cherry picked from Marvisak/VIctory 78ed12eb, #2449, without its test)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G6tkVHCftUUQbGm5NirGaG
---
 crates/victory-gpu/src/descriptor.rs | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/crates/victory-gpu/src/descriptor.rs b/crates/victory-gpu/src/descriptor.rs
index 6ec5a41..5e1592e 100644
--- a/crates/victory-gpu/src/descriptor.rs
+++ b/crates/victory-gpu/src/descriptor.rs
@@ -1536,11 +1536,19 @@ fn words<const N: usize>(desc: *const [u32; N]) -> Option<[u32; N]> {
 }
 
 /// Device method.
+///
+/// A null `desc` writes a null CBV (`Constant(0, 0)`), as D3D12's
+/// `CreateConstantBufferView` does with no description: leaving the slot
+/// as it was kept a stale view active.
 pub(crate) extern "system" fn create_cbv(_: This, desc: *const [u32; 4], handle: u64) {
-    if let Some([lo, hi, size, _]) = words(desc) {
-        let address = u64::from(lo) | u64::from(hi) << 32;
-        record(handle, View::Constant(address, size));
-    }
+    let view = match words(desc) {
+        Some([lo, hi, size, _]) => {
+            let address = u64::from(lo) | u64::from(hi) << 32;
+            View::Constant(address, size)
+        }
+        None => View::Constant(0, 0),
+    };
+    record(handle, view);
 }
 
 /// Device method.
