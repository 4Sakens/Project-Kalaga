index 72e2cf6..e4b7474 100644
--- a/crates/victory-shader/src/emit/wave64_tests.rs
+++ b/crates/victory-shader/src/emit/wave64_tests.rs
@@ -1837,3 +1837,65 @@ fn a_backward_permute_reads_within_the_lanes_half() {
     }
     eprintln!("ran on the hardware device (threads, host wave): {ran:?}");
