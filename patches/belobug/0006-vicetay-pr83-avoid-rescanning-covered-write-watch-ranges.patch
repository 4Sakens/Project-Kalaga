@@ -813,12 +828,12 @@ fn ask_ahead_held(ranges: &[(usize, usize)], held: bool) {
         let now = note_shared(&written);
         let mut j = journal_mut();
         j.ahead_asked = now;
-        j.ahead.set(asked);
+        j.ahead = ahead;
