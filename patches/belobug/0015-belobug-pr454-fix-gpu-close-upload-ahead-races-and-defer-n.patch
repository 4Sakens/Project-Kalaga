+    /// The texels of a placed texture arrive by the copy queue, all levels of
+    /// them, and what waits for them is called then; a second asking finds the
+    /// first on its way, and a later one is the list's.
+    #[test]
+    fn a_placed_texture_is_filled_ahead_of_the_lists() {
+        let Some(host) = crate::host::host() else { return };
+        let Some((texture, copy, at, whole)) = placed_texture() else { return };
         if !crate::pool::fresh(&copy.texture) {
             return;
         }
@@ -418,4 +510,51 @@ mod tests {
             back.Unmap(0, None);
         }
     }
-}
+
+    #[test]
+    fn listed_waits_while_claim_is_starting() {
+        let Some((_, copy, _, _)) = placed_texture() else { return };
+        {
+            let mut way = ON_THEIR_WAY.lock().unwrap_or_else(|e| e.into_inner());
+            assert_eq!(copy.ahead.compare_exchange(NONE, PENDING, AcqRel, Acquire), Ok(NONE));
+            way.push((copy.serial, None));
+        }
+        let starting = Starting(Some(copy.clone()));
+        let (tx, rx) = std::sync::mpsc::channel();
+        let copy_ref = copy.clone();
+        let waiter = std::thread::spawn(move || {
+            listed(&copy_ref);
+            let _ = tx.send(());
+        });
+        assert!(rx.recv_timeout(std::time::Duration::from_millis(50)).is_err());
+        drop(starting);
+        assert_eq!(rx.recv_timeout(std::time::Duration::from_secs(2)), Ok(()));
+        waiter.join().unwrap();
+        assert_eq!(copy.ahead.load(Acquire), LISTED);
+        let way = ON_THEIR_WAY.lock().unwrap_or_else(|e| e.into_inner());
+        assert!(!way.iter().any(|(serial, _)| *serial == copy.serial));
+    }
+
+    #[test]
+    fn failed_copy_leaves_texture_unuploaded_and_skips_callbacks() {
+        use std::sync::atomic::AtomicBool;
+        let Some((texture, copy, _, _)) = placed_texture() else { return };
+        if !crate::pool::fresh(&copy.texture) {
+            return;
+        }
+        let Some(Taken::New(job)) = claim(texture, 0, u64::MAX) else { panic!("not taken") };
+        let ran = Arc::new(AtomicBool::new(false));
+        let ran_cb = ran.clone();
+        job.then(move || ran_cb.store(true, Relaxed));
+        finish(vec![job.clone()], false);
+        let ran_late = ran.clone();
+        job.then(move || ran_late.store(true, Relaxed));
+        assert!(!ran.load(Relaxed));
+        assert!(!there(texture));
+        assert_eq!(copy.ahead.load(Acquire), LISTED);
+        assert!(!job.staging.uploaded.load(Acquire));
+        assert!(job.staging.dirty.load(Acquire));
+        let way = ON_THEIR_WAY.lock().unwrap_or_else(|e| e.into_inner());
+        assert!(!way.iter().any(|(serial, _)| *serial == copy.serial));
+    }
+}
