         let bytes = STATS[1].fetch_add(job.staging.read as u64, Relaxed) + job.staging.read as u64;
@@ -316,18 +398,22 @@ fn finish(jobs: Vec<Arc<Job>>) {
                 STATS[5].load(Relaxed)
             );
