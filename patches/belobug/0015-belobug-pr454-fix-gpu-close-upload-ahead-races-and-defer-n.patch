+            tracing::warn!(serial = copy.serial, "timed out waiting for upload ahead");
+            break;
+        }
         way = LANDED.wait_timeout(way, std::time::Duration::from_millis(50)).unwrap_or_else(|e| e.into_inner()).0;
     }
 }
