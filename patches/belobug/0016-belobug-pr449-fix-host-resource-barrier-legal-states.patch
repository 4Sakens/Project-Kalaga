From 999f02188022b2d103071179994d236a5eb431b3 Mon Sep 17 00:00:00 2001
From: Jorge Chavez <140349740+jorgechavezxyz@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:24:46 -0800
Subject: [PATCH] Fix host resource barrier legal states

---
 crates/victory-gpu/src/list.rs | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/crates/victory-gpu/src/list.rs b/crates/victory-gpu/src/list.rs
index a1feff3..92ccbbd 100644
--- a/crates/victory-gpu/src/list.rs
+++ b/crates/victory-gpu/src/list.rs
@@ -807,12 +807,17 @@ fn host_barrier(list: &crate::host::HostList, b: &Barrier) -> Option<Barrier> {
             // (`HostList::transition`); subresources are not told apart.
             let wanted = crate::host::texture_state(b.last as u32);
             let (texture, before) = list.transition(b.first, wanted)?;
+            let before_legal = crate::host::legal_state(texture, before);
+            let after_legal = crate::host::legal_state(texture, wanted);
+            if before_legal == after_legal {
+                return None;
+            }
             Some(Barrier {
                 kind: 0,
                 flags: 0,
                 first: texture.as_raw().cast_const().cast(),
-                second: 0xffff_ffff | (u64::from(before) << 32),
-                last: u64::from(crate::host::legal_state(texture, wanted)),
+                second: 0xffff_ffff | (u64::from(before_legal) << 32),
+                last: u64::from(after_legal),
             })
         }
         1 => Some(Barrier {
-- 
