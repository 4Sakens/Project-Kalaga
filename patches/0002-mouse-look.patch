+                let xor = [0_u8; 128];
+                // SAFETY: 32×32 masks of the sizes given.
+                self.blank = unsafe {
+                    CreateCursor(GetModuleHandleW(std::ptr::null()), 0, 0, 32, 32, and.as_ptr().cast(), xor.as_ptr().cast())
+                } as isize;
